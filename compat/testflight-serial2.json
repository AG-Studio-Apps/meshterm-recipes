{
  "_comment": "The recipes reader in TestFlight builds today (wip/s6, serial 2 bundled): placeholders {{sudo}} {{user}} {{packages}} only, any other {{name}} refuses the WHOLE file, unknown variant keys are IGNORED (so a later selector would match too widely), no minSchema, no per-schema path. Non-blocking: TestFlight only, no App Store build has recipes before 2.3.0.",
  "profile": "testflight-serial2",
  "app": "TestFlight (wip/s6)",
  "channel": "testflight",
  "blocking": false,
  "released": true,
  "fetchPaths": [
    "recipes.json"
  ],
  "reader": {
    "kind": "host-recipes",
    "maxBytes": 262144,
    "maxRun": 2000,
    "families": [
      "apt",
      "dnf",
      "yum",
      "apk",
      "pacman",
      "zypper",
      "macos",
      "unknown",
      "any"
    ],
    "privilegeWords": [
      "sudo",
      "su",
      "doas",
      "pkexec",
      "run0"
    ],
    "sudoOpeners": [
      "&& ",
      "; ",
      "then ",
      "| "
    ],
    "userPlacement": "word-outside-quotes",
    "schemas": [
      1
    ],
    "supportedSchema": 1,
    "placeholders": [
      "sudo",
      "user",
      "packages"
    ],
    "laterPlaceholders": "refuse-file",
    "variantKeys": [
      "families",
      "ids",
      "versions",
      "run",
      "admin",
      "ci"
    ],
    "unknownVariantKeys": "ignore",
    "minSchema": "ignored",
    "unusableSelection": null,
    "renderFailure": "bundled",
    "placement": {
      "group": [],
      "packagesByIntent": {}
    },
    "coverage": "bundled-family-fallbacks",
    "rollback": "below-bundled-or-current",
    "sameSerialDifferentBody": "refused"
  },
  "bundled": {
    "file": "compat/bundled/serial-2.json",
    "serial": 2,
    "sha256": "b6f029aaed5fa55bd3a08d35769eb2b66b63c1a4fc1363337fcebb9cd3aa931a"
  },
  "supplies": {
    "packages.install": [
      "packages"
    ],
    "podman.rootless-prerequisites": [
      "packages"
    ]
  },
  "unprivilegedIntents": [],
  "intents": [
    "tmux.install",
    "packages.install",
    "developer-tools.install",
    "engine.docker.install-package",
    "engine.docker.install-script",
    "engine.docker.install-alpine",
    "engine.docker.join-group",
    "engine.podman.install",
    "engine.docker-desktop.install",
    "engine.orbstack.install",
    "engine.docker.start-systemd",
    "engine.docker.start-openrc",
    "engine.podman.start-systemd",
    "engine.podman.start-systemd-user",
    "engine.podman.start-openrc",
    "engine.containerd.start-systemd",
    "engine.containerd.start-openrc",
    "engine.apple.start",
    "engine.docker-desktop.open",
    "engine.orbstack.open",
    "engine.colima.start",
    "engine.podman-machine.start",
    "compose.install-package",
    "compose.install-docker-repo",
    "compose.install-binary-docker",
    "compose.install-binary-podman",
    "podman.socket-user",
    "podman.socket-system",
    "git.install",
    "ca-certificates.install",
    "podman.rootless-prerequisites"
  ]
}
