   {
    "families": [
     "any"
    ],
    "run": "curl -fsSL https://chatgpt.com/codex/install.sh -o ~/.mt-install-codex.sh && env CODEX_NON_INTERACTIVE=1 sh ~/.mt-install-codex.sh && rm -f ~/.mt-install-codex.sh"
   }
  ],
  "agent.codex.install-homebrew": [
   {
    "families": [
     "any"
    ],
