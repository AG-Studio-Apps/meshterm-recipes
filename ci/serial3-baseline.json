  "git.install": [
   {
    "families": [
     "apt"
    ],
    "run": "{{sudo}}apt-get update && {{sudo}}apt-get install -y git"
   },
   {
    "families": [
     "dnf"
    ],
    "run": "{{sudo}}dnf install -y git"
   },
   {
    "families": [
     "apk"
    ],
    "run": "{{sudo}}apk add git"
   },
   {
    "families": [
     "macos"
    ],
    "run": "xcode-select --install"
   },
   {
    "families": [
     "unknown"
    ],
    "run": "if command -v apt-get >/dev/null; then {{sudo}}apt-get update && {{sudo}}apt-get install -y git; elif command -v dnf >/dev/null; then {{sudo}}dnf install -y git; elif command -v yum >/dev/null; then {{sudo}}yum install -y git; elif command -v apk >/dev/null; then {{sudo}}apk add git; fi"
   }
  ],
  "ca-certificates.install": [
   {
    "families": [
