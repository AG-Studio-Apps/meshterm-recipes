    "families": [
     "apt"
    ],
    "run": "{{sudo}}apt-get update && {{sudo}}apt-get install -y docker.io"
   }
  ],
  "engine.docker.install-script": [
   {
    "families": [
     "apt",
     "unknown"
    ],
    "run": "curl -fsSL https://get.docker.com | sh",
    "admin": true
   }
  ],
  "engine.docker.install-alpine": [
   {
    "families": [
     "apk"
    ],
    "run": "{{sudo}}apk add docker docker-cli-compose && {{sudo}}rc-update add docker default && {{sudo}}rc-service docker start && {{sudo}}addgroup {{user}} docker"
   }
  ],
  "engine.docker.join-group": [
   {
    "families": [
     "apt",
     "unknown"
    ],
    "run": "{{sudo}}usermod -aG docker {{user}}"
   }
