  "sudo.install": [
   {
    "families": [
     "apt"
    ],
    "run": "apt-get update && apt-get install -y {{packages}} && usermod -aG {{group}} {{user}}",
    "admin": true
   },
   {
    "families": [
     "dnf"
    ],
    "run": "dnf install -y {{packages}} && usermod -aG {{group}} {{user}}",
    "admin": true
   },
   {
    "families": [
     "apk"
    ],
    "run": "apk add {{packages}} && addgroup {{user}} {{group}} && echo \"%wheel ALL=(ALL:ALL) ALL\" > /etc/sudoers.d/wheel",
    "admin": true
   },
   {
    "families": [
     "unknown"
    ],
    "run": "apt-get update && apt-get install -y {{packages}} && usermod -aG {{group}} {{user}}",
    "admin": true
   }
  ],
  "sudo.grant": [
   {
    "families": [
     "apt"
    ],
    "run": "{{sudo}}usermod -aG {{group}} {{user}}"
   },
   {
    "families": [
     "dnf"
    ],
    "run": "{{sudo}}usermod -aG {{group}} {{user}}"
   },
   {
    "families": [
     "unknown"
    ],
    "run": "{{sudo}}usermod -aG {{group}} {{user}}"
   }
  ],
  "ssh-server.install": [
   {
    "families": [
     "apt"
    ],
    "run": "{{sudo}}apt-get update && {{sudo}}apt-get install -y openssh-server"
   },
   {
    "families": [
     "dnf"
    ],
    "run": "{{sudo}}dnf install -y openssh-server && {{sudo}}systemctl enable --now sshd"
   },
   {
    "families": [
     "apk"
    ],
    "run": "{{sudo}}apk add openssh && {{sudo}}rc-update add sshd && {{sudo}}rc-service sshd start"
   }
  ],
