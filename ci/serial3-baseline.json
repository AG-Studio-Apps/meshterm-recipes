   {
    "families": [
     "any"
    ],
    "run": "{{sudo}}systemctl reload ssh || {{sudo}}systemctl reload sshd"
   }
  ],
  "sshd.host-keys": [
   {
    "families": [
     "any"
    ],
    "run": "{{sudo}}ssh-keygen -A"
   }
  ],
  "tailscale.up-ssh": [
   {
    "families": [
     "any"
    ],
    "run": "{{sudo}}tailscale up --ssh"
   }
  ],
  "tailscale.set-ssh": [
   {
    "families": [
     "any"
    ],
    "run": "{{sudo}}tailscale set --ssh"
   }
  ],
  "firewall.ufw.allow": [
   {
    "families": [
     "any"
    ],
    "run": "{{sudo}}ufw allow {{port}}/{{proto}}"
   }
  ],
  "firewall.ufw.allow-from-tailnet": [
   {
    "families": [
     "any"
    ],
    "run": "{{sudo}}ufw allow from 100.64.0.0/10 to any port {{port}} proto {{proto}}"
   }
  ],
  "firewall.ufw.allow-on-tailscale0": [
   {
    "families": [
     "any"
    ],
    "run": "{{sudo}}ufw allow in on tailscale0 to any port {{port}} proto {{proto}}"
   }
  ],
  "firewall.firewalld.allow-ssh": [
   {
    "families": [
     "any"
    ],
    "run": "{{sudo}}firewall-cmd --permanent --add-service=ssh && {{sudo}}firewall-cmd --reload"
   }
  ],
  "firewall.firewalld.allow": [
   {
    "families": [
     "any"
    ],
    "run": "{{sudo}}firewall-cmd --permanent --add-port={{port}}/{{proto}} && {{sudo}}firewall-cmd --reload"
   }
  ],
  "firewall.firewalld.allow-from-tailnet": [
   {
    "families": [
     "any"
    ],
    "run": "{{sudo}}firewall-cmd --permanent --add-rich-rule='rule family=ipv4 source address=100.64.0.0/10 port port={{port}} protocol={{proto}} accept' && {{sudo}}firewall-cmd --reload"
   }
  ],
  "firewall.nft.allow": [
   {
    "families": [
     "any"
    ],
    "run": "{{sudo}}nft add rule inet filter input {{proto}} dport {{port}} accept"
   }
  ],
  "firewall.nft.allow-from-tailnet": [
   {
    "families": [
     "any"
    ],
    "run": "{{sudo}}nft add rule inet filter input ip saddr 100.64.0.0/10 {{proto}} dport {{port}} accept"
   }
  ],
  "firewall.iptables.allow": [
   {
    "families": [
     "any"
    ],
    "run": "{{sudo}}iptables -A INPUT -p {{proto}} --dport {{port}} -j ACCEPT"
   }
  ],
  "firewall.iptables.allow-from-tailnet": [
   {
    "families": [
     "any"
    ],
    "run": "{{sudo}}iptables -A INPUT -p {{proto}} --dport {{port}} -s 100.64.0.0/10 -j ACCEPT"
   }
  ],
  "agent.claude.install-official": [
