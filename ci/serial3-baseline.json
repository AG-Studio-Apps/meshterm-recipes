  "agent.codex.install-npm": [
   {
    "families": [
     "any"
    ],
    "run": "npm install -g --prefix \"$HOME/.local\" @openai/codex"
   }
  ],
  "agent.agy.install-official": [
   {
    "families": [
     "any"
    ],
    "run": "curl -fsSL https://antigravity.google/cli/install.sh -o ~/.mt-install-agy.sh && bash ~/.mt-install-agy.sh && rm -f ~/.mt-install-agy.sh"
   }
  ],
  "herdr.install": [
   {
    "families": [
     "any"
    ],
    "run": "curl -fsSL https://herdr.dev/install.sh -o ~/.mt-install-herdr.sh && sh ~/.mt-install-herdr.sh && rm -f ~/.mt-install-herdr.sh"
   }
  ]
 }
