   }
  ],
  "engine.docker.rootless-enable": [
   {
    "families": [
     "any"
    ],
    "run": "systemctl --user enable --now docker"
   }
  ],
  "engine.docker.rootless-start": [
   {
    "families": [
     "any"
    ],
    "run": "systemctl --user start docker"
   }
  ],
  "engine.rootless.linger": [
   {
    "families": [
     "any"
    ],
    "run": "{{sudo}}loginctl enable-linger {{user}}"
   }
  ],
  "engine.rootless.apparmor-userns": [
   {
    "families": [
     "any"
    ],
    "run": "f=$(echo {{path}} | sed -e 's@^/@@' -e 's@/@.@g') && { echo 'abi <abi/4.0>,'; echo 'include <tunables/global>'; echo '\"{{path}}\" flags=(unconfined) {'; echo '  userns,'; echo '}'; } | {{sudo}}tee \"/etc/apparmor.d/$f\" >/dev/null && {{sudo}}systemctl restart apparmor.service"
   }
  ],
  "engine.docker.start-service-systemd": [
   {
    "families": [
     "any"
    ],
    "run": "{{sudo}}systemctl start docker"
   }
  ],
  "engine.docker.start-socket-systemd": [
   {
    "families": [
     "any"
    ],
