  "compose.install-package": [
   {
    "families": [
     "apt"
    ],
    "ids": [
     "ubuntu",
     "linuxmint",
     "pop"
    ],
    "run": "{{sudo}}apt-get update && {{sudo}}apt-get install -y docker-compose-v2"
   },
   {
    "families": [
     "dnf"
    ],
    "run": "{{sudo}}dnf install -y docker-compose"
   },
   {
    "families": [
     "apk"
    ],
    "run": "{{sudo}}apk add docker-cli-compose"
   },
   {
    "families": [
     "macos"
    ],
    "run": "brew install docker-compose"
   }
  ],
  "compose.install-docker-repo": [
   {
    "families": [
     "any"
    ],
    "run": "curl -fsSL https://get.docker.com | sh",
    "admin": true
   }
  ],
  "compose.install-binary-docker": [
   {
    "families": [
     "apt",
     "dnf",
     "unknown"
    ],
    "run": "{{sudo}}mkdir -p /usr/local/lib/docker/cli-plugins && {{sudo}}curl -fsSL \"https://github.com/docker/compose/releases/latest/download/docker-compose-linux-$(uname -m)\" -o /usr/local/lib/docker/cli-plugins/docker-compose && {{sudo}}chmod +x /usr/local/lib/docker/cli-plugins/docker-compose"
   }
  ],
  "compose.install-binary-podman": [
   {
    "families": [
     "apt",
     "dnf",
     "unknown"
    ],
    "run": "{{sudo}}curl -fsSL \"https://github.com/docker/compose/releases/latest/download/docker-compose-linux-$(uname -m)\" -o /usr/local/bin/docker-compose && {{sudo}}chmod +x /usr/local/bin/docker-compose"
   }
  ],
  "podman.socket-user": [
   {
    "families": [
     "any"
    ],
    "run": "{ systemctl --user is-active --quiet podman.socket || systemctl --user enable --now podman.socket; }"
   }
  ],
  "podman.socket-system": [
   {
    "families": [
     "any"
    ],
    "run": "{ systemctl is-active --quiet podman.socket || {{sudo}}systemctl enable --now podman.socket; }",
    "admin": true
   }
