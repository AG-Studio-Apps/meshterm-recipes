    ],
    "run": "{{sudo}}dnf install -y ca-certificates"
   },
   {
    "families": [
     "apk"
    ],
    "run": "{{sudo}}apk add ca-certificates"
   },
   {
    "families": [
     "unknown"
    ],
    "run": "if command -v apt-get >/dev/null; then {{sudo}}apt-get update && {{sudo}}apt-get install -y ca-certificates; elif command -v dnf >/dev/null; then {{sudo}}dnf install -y ca-certificates; elif command -v yum >/dev/null; then {{sudo}}yum install -y ca-certificates; elif command -v apk >/dev/null; then {{sudo}}apk add ca-certificates; fi"
   }
  ],
  "podman.rootless-prerequisites": [
   {
    "families": [
     "apt"
    ],
    "ids": [
     "ubuntu",
     "debian",
     "raspbian",
     "linuxmint",
     "pop"
    ],
    "run": "{{sudo}}apt install -y {{packages}} passt"
   },
   {
    "families": [
     "dnf"
    ],
    "ids": [
     "fedora",
     "rhel",
     "centos",
     "rocky",
     "almalinux"
    ],
