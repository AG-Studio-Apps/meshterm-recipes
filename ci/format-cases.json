{
  "_comment": "The format's good and bad cases, run by BOTH scripts/validate.py --self-test and meshTerm's HostRecipesTests (a byte-identical copy in its test fixtures), so the Python and Swift rules agree case by case. templates: a run text (in `intent` when given) is ok, unusable (a later app's placeholder: the variant is skipped, the file accepted) or refused (the whole file). variants: a whole variant object, same three results. renders: the text for the given values (null: not rendered). selection: which run the app picks for an OS (null: none), with the bundled document's variants as the fallback for an unusable winner.",
  "templates": [
    {"run": "{{sudo}}apt-get update && {{sudo}}apt-get install -y {{packages}}", "result": "ok"},
    {"run": "{{sudo}}usermod -aG docker {{user}}", "result": "ok"},
    {"run": "{{sudo}}ufw allow {{port}}/{{proto}}", "result": "ok"},
    {"run": "{{sudo}}firewall-cmd --permanent --add-rich-rule='rule family=ipv4 source address=100.64.0.0/10 port port={{port}} protocol={{proto}} accept' && {{sudo}}firewall-cmd --reload", "result": "ok"},
    {"run": "{{sudo}}usermod -aG {{group}} {{user}}", "result": "ok"},
    {"run": "usermod -G {{group}} {{user}}", "result": "ok"},
    {"run": "apk add {{packages}} && addgroup {{user}} {{group}}", "intent": "sudo.install", "result": "ok"},
    {"run": "echo {{group}}", "result": "refused", "why": "{{group}} only after -aG, -G or addgroup {{user}}"},
    {"run": "{{group}} x", "result": "refused"},
    {"run": "{{sudo}}usermod -aG docker,{{group}} {{user}}", "result": "refused"},
    {"run": "f=$(echo {{path}} | sed -e 's@^/@@') && echo '\"{{path}}\" flags=(unconfined) {' | {{sudo}}tee \"/etc/apparmor.d/$f\" >/dev/null", "result": "ok"},
    {"run": "apt-get install -y {{packages}} && usermod -aG {{group}} {{user}}", "intent": "sudo.install", "result": "ok"},
    {"run": "dnf install -y {{packages}} && usermod -aG {{group}} {{user}}", "intent": "sudo.install", "result": "ok"},
    {"run": "w=; p=\"{{packages}}\" && apt-get install -y $p", "intent": "sudo.install", "result": "ok"},
    {"run": "echo {{packages}}", "intent": "sudo.install", "result": "refused", "why": "{{packages}} in sudo.install only after an install verb"},
    {"run": "echo {{packages}}", "intent": "packages.install", "result": "ok"},
    {"run": "{{sudo}}apt-get install -y {{newthing}}", "result": "unusable", "why": "a later app's placeholder"},
    {"run": "sudo apt-get install -y {{newthing}}", "result": "refused", "why": "security rules never degrade to unusable"},
    {"run": "{{ sudo }}apt-get install -y x", "result": "refused", "why": "not a placeholder name at all"},
    {"run": "{{Sudo}}apt-get install -y x", "result": "refused"},
    {"run": "{{root}}apt-get install -y x", "result": "unusable"},
    {"run": "echo {{sudo", "result": "refused"},
    {"run": "echo }}", "result": "refused"},
    {"run": "sudo apt-get install -y x", "result": "refused"},
    {"run": "x && \"su\" -c y", "result": "refused"},
    {"run": "/usr/bin/sudo apt-get install -y x", "result": "refused"},
    {"run": "doas apk add x", "result": "refused"},
    {"run": "echo x {{sudo}}apt-get install -y x", "result": "refused"},
    {"run": "{{sudo}} apt-get install -y x", "result": "refused"},
    {"run": "echo \"{{user}}\"", "result": "refused"},
    {"run": "\\sudo x", "result": "refused"},
    {"run": "apk add {{packages}} {{packages}}", "result": "refused"},
    {"run": "visudo -cf /etc/sudoers.d/x.new && mv /etc/sudoers.d/x.new /etc/sudoers.d/x", "result": "ok"},
    {"run": "{{sudo}}nft list chain inet filter input >/dev/null 2>&1 && {{sudo}}nft add rule inet filter input {{proto}} dport {{port}} accept || { echo \"No inet filter input chain here: use firewalld or ufw\"; false; }", "result": "ok"}
  ],
  "variants": [
    {"variant": {"families": ["apt"], "run": "a", "minSchema": 1}, "result": "ok"},
    {"variant": {"families": ["apt"], "run": "a", "minSchema": 2}, "result": "unusable"},
    {"variant": {"families": ["apt"], "run": "a", "minSchema": 0}, "result": "refused"},
    {"variant": {"families": ["apt"], "run": "a", "minSchema": "2"}, "result": "refused"},
    {"variant": {"families": ["apt"], "run": "a", "minSchema": true}, "result": "refused"},
    {"variant": {"families": ["apt"], "run": "a", "init": "openrc"}, "result": "unusable"},
