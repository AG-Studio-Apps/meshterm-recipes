     "why": "equal score: the unusable one wins the tie, and the bundled document has none"},
    {"variants": [{"families": ["any"], "run": "any"}, {"families": ["apt"], "run": "{{sudo}}x {{later}}"}],
     "bundled": [{"families": ["any"], "run": "bundled-any"}],
