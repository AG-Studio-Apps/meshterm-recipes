    {"run": "{{sudo}}addgroup {{user}} docker", "values": {"sudo": true, "user": "{{sudo}}"}, "out": "sudo addgroup '{{sudo}}' docker"},
    {"run": "{{sudo}}apk add {{packages}}", "values": {"sudo": true, "packages": ["{{user}}"]}, "out": null},
    {"run": "{{sudo}}addgroup {{user}} docker", "values": {"sudo": true, "user": "o'brien"}, "out": "sudo addgroup 'o'\\''brien' docker"},
    {"run": "{{sudo}}addgroup {{user}} docker", "values": {"sudo": true, "user": "-rf"}, "out": null}
  ],
  "selection": [
    {"variants": [{"families": ["apt"], "run": "family"}, {"families": ["apt"], "ids": ["debian"], "run": "later", "init": "openrc"}],
     "bundled": [{"families": ["apt"], "run": "bundled-family"}, {"families": ["apt"], "ids": ["debian"], "run": "bundled-debian"}],
     "os": {"family": "apt", "id": "debian"}, "pick": "bundled-debian",
     "why": "an unusable variant outranks the usable family line: the bundled answer"},
    {"variants": [{"families": ["apt"], "run": "family"}, {"families": ["apt"], "ids": ["debian"], "run": "later", "init": "openrc"}],
     "bundled": [{"families": ["apt"], "run": "bundled-family"}],
     "os": {"family": "apt", "id": "debian"}, "pick": "bundled-family"},
    {"variants": [{"families": ["apt"], "run": "family"}, {"families": ["apt"], "ids": ["debian"], "run": "later", "init": "openrc"}],
     "bundled": [{"families": ["apt"], "run": "bundled-family"}],
     "os": {"family": "apt", "id": "ubuntu"}, "pick": "family",
     "why": "the unusable variant does not apply to ubuntu"},
    {"variants": [{"families": ["apt"], "ids": ["debian"], "run": "debian"}, {"families": ["apt"], "run": "later", "minSchema": 2}],
     "bundled": [{"families": ["apt"], "run": "bundled-family"}],
     "os": {"family": "apt", "id": "debian"}, "pick": "debian",
     "why": "a usable variant that outranks the unusable one stands"},
    {"variants": [{"families": ["apt"], "run": "family"}, {"families": ["apt", "dnf"], "run": "later", "minSchema": 2}],
     "bundled": [],
