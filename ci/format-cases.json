    {"variant": {"families": ["APT"], "run": "a", "init": "openrc"}, "result": "refused"},
    {"variant": {"families": ["apt"], "ids": ["Ubuntu"], "run": "a", "init": "openrc"}, "result": "refused"},
    {"variant": {"families": ["apt"], "run": "a", "admin": 1}, "result": "refused"}
